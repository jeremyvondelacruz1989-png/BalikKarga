{
  "name": "BalikKarga",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "cp -n .env.example .env; npm install && npm run db:reset",
  "postAttachCommand": "npm run dev",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "BalikKarga app", "onAutoForward": "openBrowser" }
  }
}
