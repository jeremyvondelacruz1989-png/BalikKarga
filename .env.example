# Local development uses SQLite. For production, switch the provider in
# prisma/schema.prisma to "postgresql" and point this at Supabase/Neon/etc.
DATABASE_URL="file:./dev.db"

# Uploaded files (verification documents, receipts, delivery photos).
# Local disk works for dev and single-server hosting. On Vercel, swap the driver in
# src/lib/storage.ts for Supabase Storage / S3 (the disk there is not persistent).
UPLOAD_DIR="./uploads"

# SMS via Semaphore (semaphore.co). Leave empty to run in test mode:
# messages are logged on the admin page instead of being sent.
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME="BALIKKARGA"

# Where truckers send top-up payments (shown on the Credits page).
# NEXT_PUBLIC_PAY_GCASH=""
# NEXT_PUBLIC_PAY_MAYA=""
# NEXT_PUBLIC_PAY_BANK=""

# Public URL of the app, used for links inside SMS (e.g. https://balikkarga.ph).
APP_URL="http://localhost:3000"
