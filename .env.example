# ---- Database (PostgreSQL) -------------------------------------------------------------
# Local (Codespace or your machine): the Postgres from .devcontainer/docker-compose.yml.
# Live (Vercel): the Supabase connection strings, from Supabase → Connect:
#   DATABASE_URL = "Transaction pooler" string (port 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = "Session pooler" string (port 5432), used only to run migrations
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/balikkarga"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/balikkarga"

# ---- Uploaded files ----------------------------------------------------------------------
# Live: Supabase Storage. SUPABASE_SECRET_KEY is a secret key from Supabase → Project Settings → API Keys.
# Leave both empty to store files on local disk (UPLOAD_DIR), as in the Codespace.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
SUPABASE_BUCKET="uploads"
UPLOAD_DIR="./uploads"

# ---- App ---------------------------------------------------------------------------------
# Public URL of the app, used for links inside SMS (e.g. https://balikkarga.vercel.app).
APP_URL="http://localhost:3000"
# The first person to sign up with one of these emails becomes the admin (only while no admin exists).
ADMIN_EMAILS=""
# Welcome credits for new truckers (one per mobile number). 0 turns the promo off.
SIGNUP_BONUS=300

# ---- SMS via Semaphore (semaphore.co) ------------------------------------------------------
# Leave empty for test mode: messages are logged on the admin page instead of being sent.
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME="BALIKKARGA"

# ---- Where truckers send top-up payments (shown on the Credits page) -----------------------
# NEXT_PUBLIC_PAY_GCASH=""
# NEXT_PUBLIC_PAY_MAYA=""
# NEXT_PUBLIC_PAY_BANK=""
